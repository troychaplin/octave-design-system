{
    "prefix": "octave",

    "output": {
        "srcDir": "src/styles/c2b",
        "outputDir": "dist/styles",
        "wpTheme": "dist/wordpress",
        "fontsDir": "public/fonts",
        "themeable": false,
        "emitScssAlongside": true,
        "emitAggregate": false,
        "scssVars": ["viewport", "spacing"]
    },

    "tokens": {
        "layout": {
            "contentSize": "768px",
            "wideSize": "1152px",
            "smallSize": { "value": "600px", "cssOnly": true },
            "fullSize": { "value": "100vw", "cssOnly": true }
        },

        "viewport": {
            "mobile": "600px",
            "tablet": "768px"
        },

        "color": {
            "black": "#191919",
            "white": "#ffffff",
            "accent-primary": { "value": "#a34f3e" },
            "accent-secondary": { "value": "#ca2135" },
            "neutral-50": { "value": "#f9f7f3" },
            "neutral-100": { "value": "#f2f0ea" },
            "neutral-200": { "value": "#efeae2" },
            "neutral-300": { "value": "#e0d6c8" },
            "neutral-400": { "value": "#d8d5cf" },
            "neutral-500": { "value": "#8d7661" },
            "neutral-600": { "value": "#766051" },
            "neutral-700": { "value": "#5e4c42" },
            "neutral-800": { "value": "#51413a" },
            "neutral-900": { "value": "#473a35" },
            "neutral-950": { "value": "#271f1c" },
            "info": { "value": "#2571eb", "cssOnly": true },
            "success": { "value": "#16a34a", "cssOnly": true },
            "warning": { "value": "#fff154", "cssOnly": true },
            "error": { "value": "#dc2626", "cssOnly": true },
            "linkedin": { "value": "#0A66C2", "cssOnly": true },
            "facebook": { "value": "#1877F2", "cssOnly": true },
            "bluesky": { "value": "#1185FE", "cssOnly": true },
            "twitter": { "value": "#000000", "cssOnly": true },
            "instagram": { "value": "#E4405F", "cssOnly": true },
            "youtube": { "value": "#FF0000", "cssOnly": true },
            "tiktok": { "value": "#010101", "cssOnly": true }
        },

        "gradient": {
            "white-to-neutral-50": {
                "value": "linear-gradient(135deg,rgb(250,250,250) 0%,rgb(249, 247, 243) 90%)",
                "slug": "custom-white-to-neutral-50"
            }
        },

        "fontFamily": {
            "inter-tight": {
                "value": "Inter Tight, system-ui, Segoe UI, roboto, sans-serif",
                "fontFace": [
                    {
                        "weight": "100 900",
                        "style": "normal",
                        "src": "inter-tight-variable-normal.woff2"
                    },
                    {
                        "weight": "100 900",
                        "style": "italic",
                        "src": "inter-tight-variable-italic.woff2"
                    }
                ]
            },
            "source-serif-4": {
                "value": "Source Serif 4, ui-serif, georgia, serif",
                "fontFace": [
                    {
                        "weight": "200 900",
                        "style": "normal",
                        "src": "source-serif-4-variable-normal.woff2"
                    },
                    {
                        "weight": "200 900",
                        "style": "italic",
                        "src": "source-serif-4-variable-italic.woff2"
                    }
                ]
            },
            "jetbrains-mono": {
                "value": "JetBrains Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace",
                "fontFace": [
                    {
                        "weight": "100 800",
                        "style": "normal",
                        "src": "jetbrains-mono-variable-normal.woff2"
                    },
                    {
                        "weight": "100 800",
                        "style": "italic",
                        "src": "jetbrains-mono-variable-italic.woff2"
                    }
                ]
            }
        },

        "fontWeight": {
            "thin": "100",
            "extra-light": "200",
            "light": "300",
            "normal": "400",
            "medium": "500",
            "semibold": "600",
            "bold": "700",
            "extra-bold": "800",
            "black": "900"
        },

        "fontSize": {
            "2-x-small": { "value": "0.75rem", "fluid": { "min": "0.6875rem", "max": "0.75rem" } },
            "x-small": { "value": "0.875rem", "fluid": { "min": "0.8125rem", "max": "0.875rem" } },
            "small": { "value": "1rem", "fluid": { "min": "0.875rem", "max": "1rem" } },
            "medium": { "value": "1.25rem", "fluid": { "min": "1rem", "max": "1.25rem" } },
            "large": { "value": "1.5rem", "fluid": { "min": "1rem", "max": "1.5rem" } },
            "x-large": { "value": "2rem", "fluid": { "min": "1.4375rem", "max": "2rem" } },
            "2-x-large": {
                "value": "2.6875rem",
                "fluid": { "min": "1.75rem", "max": "2.6875rem" }
            },
            "3-x-large": {
                "value": "3.5625rem",
                "fluid": { "min": "2.0625rem", "max": "3.5625rem" }
            },
            "4-x-large": {
                "value": "4.75rem",
                "fluid": { "min": "2.5rem", "max": "4.75rem" }
            },
            "5-x-large": {
                "value": "5.7125rem",
                "fluid": { "min": "2.375rem", "max": "5.7125rem" }
            },
            "hero": {
                "value": "8.4375rem",
                "fluid": { "min": "3.5625rem", "max": "8.4375rem" }
            },
            "heading-small": { "value": "1.5rem", "fluid": { "min": "1rem", "max": "1.5rem" } },
            "heading-medium": {
                "value": "1.75rem",
                "fluid": { "min": "1.25rem", "max": "1.75rem" }
            },
            "heading-large": { "value": "2.25rem", "fluid": { "min": "1.5rem", "max": "2.25rem" } },
            "heading-x-large": {
                "value": "2.5rem",
                "fluid": { "min": "1.75rem", "max": "2.5rem" }
            },
            "heading-primary": { "value": "3rem", "fluid": { "min": "1.75rem", "max": "3rem" } }
        },

        "spacing": {
            "3-x-small": { "value": "0.175rem", "slug": "10" },
            "2-x-small": { "value": "0.25rem", "slug": "20" },
            "x-small": { "value": "0.5rem", "slug": "30" },
            "small": {
                "value": "clamp(0.625rem, 0.625rem + ((1vw - 0.2rem) * 0.240), 0.75rem)",
                "slug": "40"
            },
            "normal": {
                "value": "clamp(0.8125rem, 0.8125rem + ((1vw - 0.2rem) * 0.361), 1rem)",
                "slug": "50"
            },
            "medium": {
                "value": "clamp(0.9375rem, 0.9375rem + ((1vw - 0.2rem) * 0.601), 1.25rem)",
                "slug": "60"
            },
            "large": {
                "value": "clamp(1.0625rem, 1.0625rem + ((1vw - 0.2rem) * 0.841), 1.5rem)",
                "slug": "70"
            },
            "x-large": {
                "value": "clamp(1.1875rem, 1.1875rem + ((1vw - 0.2rem) * 1.563), 2rem)",
                "slug": "80"
            },
            "2-x-large": {
                "value": "clamp(1.3125rem, 1.3125rem + ((1vw - 0.2rem) * 2.284), 2.5rem)",
                "slug": "90"
            },
            "3-x-large": {
                "value": "clamp(1.4375rem, 1.4375rem + ((1vw - 0.2rem) * 3.005), 3rem)",
                "slug": "100"
            },
            "4-x-large": {
                "value": "clamp(1.625rem, 1.625rem + ((1vw - 0.2rem) * 4.567), 4rem)",
                "slug": "110"
            },
            "5-x-large": {
                "value": "clamp(1.75rem, 1.75rem + ((1vw - 0.2rem) * 6.250), 5rem)",
                "slug": "120"
            }
        },

        "shadow": {
            "natural": "6px 6px 9px rgba(0, 0, 0, 0.2)",
            "deep": "12px 12px 50px rgba(0, 0, 0, 0.4)",
            "sharp": "6px 6px 0px rgba(0, 0, 0, 0.2)",
            "outlined": "6px 6px 0px -3px rgb(255, 255, 255), 6px 6px rgb(0, 0, 0)",
            "crisp": "6px 6px 0px rgb(0, 0, 0)"
        },

        "lineHeight": {
            "tight": "1.3",
            "normal": "1.6",
            "loose": "1.8"
        },

        "zIndex": {
            "100": "100",
            "200": "200",
            "500": "500"
        },

        "radius": {
            "sm": "2px",
            "md": "4px",
            "lg": "8px",
            "xl": "12px",
            "full": "9999px"
        },

        "transition": {
            "fast": "150ms ease",
            "base": "250ms ease"
        }
    },

    "baseStyles": {
        "body": {
            "fontFamily": "source-serif-4",
            "fontSize": "small",
            "fontWeight": "300",
            "lineHeight": "normal",
            "color": "black",
            "background": "white"
        },
        "heading": {
            "fontFamily": "inter-tight",
            "color": "neutral-800",
            "lineHeight": "1.1"
        },
        "h1": {
            "fontSize": "hero",
            "fontWeight": "600",
            "marginBlockStart": "large"
        },
        "h2": {
            "fontSize": "4-x-large",
            "fontWeight": "600",
            "marginBlockStart": "medium"
        },
        "h3": {
            "fontSize": "3-x-large",
            "fontWeight": "600",
            "marginBlockStart": "medium"
        },
        "h4": {
            "fontSize": "2-x-large",
            "fontWeight": "600",
            "marginBlockStart": "medium"
        },
        "h5": {
            "fontSize": "x-large",
            "fontWeight": "600",
            "marginBlockStart": "medium"
        },
        "h6": {
            "fontSize": "x-large",
            "fontWeight": "600",
            "fontStyle": "italic",
            "marginBlockStart": "medium"
        },
        "caption": {
            "fontSize": "small",
            "fontStyle": "italic",
            "fontWeight": "light",
            "color": "warning"
        },
        "button": { "color": "white", "background": "black" },
        "link": { "color": "success", "hoverColor": "error" },
        "spacing": {
            "blockGap": "0",
            "afterHeading": "small",
            "entryContent": "normal",
            "listItem": "x-small",
            "padding": {
                "top": "0",
                "right": "medium",
                "bottom": "0",
                "left": "medium"
            }
        }
    }
}
